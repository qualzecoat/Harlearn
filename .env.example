# Copy to .env (NEVER commit .env). Placeholders only — no real values here.
# TAILSCALE_IP: the host's Tailscale IP at deploy time (e.g. 100.x.y.z).
# Leave it unset/127.0.0.1 for host-only local runs. Never 0.0.0.0.
TAILSCALE_IP=127.0.0.1
# Generate with: python tools/hash_password.py  (Argon2 hash, NOT a password)
HARLEARN_APP_PASSWORD_HASH=
POSTGRES_USER=harlearn
POSTGRES_PASSWORD=harlearn
POSTGRES_DB=harlearn
# Origin the browser uses for the web UI (must match the published web port).
WEB_ORIGIN=http://127.0.0.1:8100
# Browser -> API routing: the browser calls same-origin /api/* and the
# Next.js web service rewrites it to the internal `api` service
# (API_INTERNAL_URL=http://api:8000 in compose). The API is intentionally
# NOT published, so no browser-facing API URL is needed here.
# For local (non-compose) dev only, set API_INTERNAL_URL=http://127.0.0.1:8000
# when building/running the web service.
# Set to true only when the web UI is served over HTTPS.
COOKIE_SECURE=false
